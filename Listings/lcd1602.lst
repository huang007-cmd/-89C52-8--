  95          //------------------------------------------------
  96          // 设置光标位置 (x: 0-15, y: 0-1)
  97          //------------------------------------------------
  98          void LCD_SetCursor(unsigned char x, unsigned char y)
  99          {
 100   1          unsigned char pos;
 101   1          
 102   1          // 限制范围
 103   1          if(x > 15) x = 0;
 104   1          if(y > 1) y = 0;
 105   1          
 106   1          pos = (y == 0) ? (LCD_LINE1 + x) : (LCD_LINE2 + x);
 107   1          LCD_WriteCommand(pos);
 108   1      }
