 119          //------------------------------------------------
 120          // 显示字符串
 121          //------------------------------------------------
 122          void LCD_ShowString(unsigned char x, unsigned char y, char *str)
 123          {
 124   1          LCD_SetCursor(x, y);
 125   1          while(*str)
 126   1          {
 127   2              LCD_WriteData(*str++);
 128   2          }
 129   1      }
 130          
 131          //------------------------------------------------
 132          // 显示无符号整数（0-65535）
 133          //------------------------------------------------
 134          void LCD_ShowNum(unsigned char x, unsigned char y, unsigned int num, unsigned char len)
 135          {
 136   1          unsigned char i;
 137   1          unsigned char buf[6];
 138   1          
 139   1          // 数字转字符串
 140   1          for(i = 0; i < len; i++)
 141   1          {
 142   2              buf[len - 1 - i] = (num % 10) + '0';
 143   2              num /= 10;
 144   2          }
 145   1          
 146   1          // 显示
 147   1          LCD_SetCursor(x, y);
 148   1          for(i = 0; i < len; i++)
 149   1          {
 150   2              LCD_WriteData(buf[i]);
 151   2          }
 152   1      }
 153          
 154          //------------------------------------------------
 155          // 显示十六进制数
 156          //------------------------------------------------
 157          void LCD_ShowHex(unsigned char x, unsigned char y, unsigned char hex)
 158          {
 159   1          unsigned char high, low;
 160   1          
 161   1          high = (hex >> 4) & 0x0F;
 162   1          low = hex & 0x0F;
 163   1          
 164   1          LCD_SetCursor(x, y);
 165   1          LCD_WriteData((high < 10) ? (high + '0') : (high - 10 + 'A'));
 166   1          LCD_WriteData((low < 10) ? (low + '0') : (low - 10 + 'A'));
 167   1      }
