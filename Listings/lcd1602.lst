   7          sbit LCD_RS = P2^6;
   8          sbit LCD_RW = P2^5;
   9          sbit LCD_EN = P2^7;
  10          sbit LCD_D4 = P2^1;
  11          sbit LCD_D5 = P2^2;
  12          sbit LCD_D6 = P2^3;
  13          sbit LCD_D7 = P2^4;
  14          
  15          //------------------------------------------------
  16          // LCD 指令定义（提高可读性）
  17          //------------------------------------------------
  18          #define LCD_CLEAR           0x01  // 清屏
  19          #define LCD_HOME            0x02  // 光标归位
  20          #define LCD_ENTRY_MODE      0x06  // 光标右移，不移动显示
  21          #define LCD_DISPLAY_ON      0x0C  // 显示开，光标关，不闪烁
  22          #define LCD_DISPLAY_CURSOR  0x0E  // 显示开，光标开，不闪烁
  23          #define LCD_DISPLAY_BLINK   0x0F  // 显示开，光标开，闪烁
  24          #define LCD_4BIT_2LINE      0x28  // 4位模式，2行，5x7字体
  25          #define LCD_LINE1           0x80  // 第一行起始地址
  26          #define LCD_LINE2           0xC0  // 第二行起始地址
  27          
  28          
  29          //------------------------------------------------
  30          // 发送半字节（4bit）- 底层函数
  31          //------------------------------------------------
  32          void LCD_Send4Bit(unsigned char dat)
  33          {
  34   1          LCD_D7 = (dat >> 3) & 0x01;
  35   1          LCD_D6 = (dat >> 2) & 0x01;
  36   1          LCD_D5 = (dat >> 1) & 0x01;
  37   1          LCD_D4 = dat & 0x01;
  38   1      }
  39          
  40          //------------------------------------------------
  41          // 使能脉冲 - 独立函数提高复用性
  42          //------------------------------------------------
  43          void LCD_EnablePulse(void)
  44          {
  45   1          LCD_EN = 1;
  46   1          Delay_us(1);  // 使能脉冲至少450ns
  47   1          LCD_EN = 0;
  48   1          Delay_us(50); // 命令执行时间
  49   1      }
  50          
  51          //------------------------------------------------
  52          // 写字节（4位模式）- 统一底层接口
  53          //------------------------------------------------
  54          void LCD_WriteByte(unsigned char rs, unsigned char dat)
C51 COMPILER V9.60.7.0   LCD1602                                                           12/28/2025 15:36:46 PAGE 2   

  55          {
  56   1          LCD_RS = rs;  // 0=命令, 1=数据
  57   1          LCD_RW = 0;   // 写模式
  58   1          
  59   1          // 发送高4位
  60   1          LCD_Send4Bit(dat >> 4);
