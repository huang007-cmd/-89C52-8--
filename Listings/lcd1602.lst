  64   1          LCD_Send4Bit(dat);
  65   1          LCD_EnablePulse();
  66   1          
  67   1          Delay_ms(2);  // 等待命令执行完成
  68   1      }
  69          
  70          //------------------------------------------------
  71          // 发送命令
  72          //------------------------------------------------
  73          void LCD_WriteCommand(unsigned char cmd)
  74          {
  75   1          LCD_WriteByte(0, cmd);
  76   1      }
  77          
  78          //------------------------------------------------
  79          // 发送数据
  80          //------------------------------------------------
  81          void LCD_WriteData(unsigned char dat)
  82          {
