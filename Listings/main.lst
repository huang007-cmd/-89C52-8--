 104          /**
 105           * @brief 定时器0初始化（1ms中断）
 106           * @note  使用Timer0，工作方式1，产生1ms中断
 107           */
 108          void Timer0_Init()
 109          {
 110   1              TMOD &= 0xF0; // 清除Timer0的设置
 111   1              TMOD |= 0x01; // Timer0工作方式1（16位定时器）
 112   1      
 113   1              // 设置初值，产生1ms中断（假设晶振为11.0592MHz）
 114   1              TH0 = 0xFC; // 65536 - 1000 = 64536 = 0xFC18
 115   1              TL0 = 0x18;
 116   1      
C51 COMPILER V9.60.7.0   MAIN                                                              12/28/2025 15:36:46 PAGE 3   

 117   1              ET0 = 1; // 使能Timer0中断
 118   1              EA = 1;  // 使能总中断
 119   1              TR0 = 1; // 启动Timer0
 120   1      }
 121          
 122          /**
 123           * @brief Timer0中断服务函数
 124           * @note  每1ms进入一次
 125           */
 126          void Timer0_ISR() interrupt 1
 127          {
 128   1              // 重装初值
 129   1              TH0 = 0xFC;
 130   1              TL0 = 0x18;
 131   1      
 132   1              timer_count++;
 133   1      
 134   1              // 1000ms = 1s
 135   1              if (timer_count >= 1000)
 136   1              {
 137   2                      timer_count = 0;
 138   2                      timer_1s_flag = 1; // 设置1秒标志
 139   2              }
 140   1      }


